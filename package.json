    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.6",
    "@tailwindcss/vite": "^4.1.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^9.2.0",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "lodash-es": "^4.17.21",
    "lucide-vue-next": "^0.468.0",
    "markdown-it": "^15.0.3",
    "reka-ui": "^2.4.1",
    "tailwind-merge": "^3.3.1",
    "vue": "^3.5.18"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "vite": "^7.0.6"
